# Copy this file to .env and adjust. .env is git-ignored, so your keys stay local.

# Provider: "ollama" (local, free, no key) or "openai" (needs a funded key).
PROVIDER=ollama

# Ollama (local) settings, used when PROVIDER=ollama.
# Pull the models first:  ollama pull nomic-embed-text  &&  ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# OpenAI settings, used when PROVIDER=openai (the assignment default stack).
# OPENAI_API_KEY=your_key_here
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_MODEL=gpt-4o

# Optional overrides.
# LLM_TEMPERATURE=0.0
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# DEFAULT_TOP_K=4
# COLLECTION_NAME=financial_reports
